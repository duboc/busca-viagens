# SkyAgent — Environment Variables
# Copy this file to .env and fill in your values.
# All variables are optional — the app works without them,
# but features will be limited without API keys.

# ─── API Keys ───────────────────────────────────────────
# Gemini API key (required for AI-powered flight search)
# Get yours at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Gemini model to use (default: gemini-2.0-flash)
VITE_GEMINI_MODEL=gemini-2.0-flash

# ─── Amadeus API (optional) ─────────────────────────────
# For real flight data from airline GDS
# Register at: https://developers.amadeus.com
VITE_AMADEUS_CLIENT_ID=
VITE_AMADEUS_CLIENT_SECRET=
VITE_AMADEUS_ENV=test

# ─── CORS Proxy (optional) ──────────────────────────────
# Used for Google Flights scraping fallback
VITE_CORS_PROXY=https://api.allorigins.win/raw?url=

# ─── Defaults (optional) ────────────────────────────────
VITE_DEFAULT_CURRENCY=BRL
VITE_DEFAULT_CABIN=economy
